<%- include("header") -%>

  <div class="box" id="heading">
    <h1>
      <%= listTitle %>
    </h1>

    <% if (typeof allLists !=="undefined" && allLists.length> 0) { %>
      <div style="padding: 0 12px 18px; text-align: center;">
        <label for="listNav" style="color: white; font-size: 14px; display: block; margin-bottom: 8px;">
          📋 Listas tareas de María Rozas Casero
        </label>

        <select id="listNav"
          onchange="if (this.value) window.location.href = this.value === 'Today' ? '/' : '/' + encodeURIComponent(this.value);"
          style="max-width: 100%; padding: 8px 12px; border-radius: 8px; border: 1px solid #ccc; background: white; color: #333; font-size: 14px; cursor: pointer;">
          <option value="">-- Selecciona o cambia de lista --</option>

          <option value="Today" <%=listTitle==="Today" ? "selected" : "" %>
            >
            📅 Today
          </option>

          <% allLists.forEach(function(list) { %>
            <% if (list.name !=="Today" ) { %>
              <option value="<%= list.name %>" <%=listTitle===list.name ? "selected" : "" %>
                >
                📌 <%= list.name %>
              </option>
              <% } %>
                <% }); %>
        </select>
      </div>
      <% } %>
  </div>

  <div class="box">
    <% newListItems.forEach(function(item) { %>
      <form action="/delete" method="post">
        <div class="item">
          <input type="checkbox" name="checkbox" value="<%= item._id %>" onchange="this.form.submit()">

          <p>
            <%= item.name %>

              <% if (typeof item.priority_name !=="undefined" && item.priority_name) { %>
                <span class="badge" style="background-color: <%= item.priority_color %>;">
                  <%= item.priority_name %>
                </span>
                <% } %>
          </p>
        </div>

        <input type="hidden" name="listName" value="<%= listTitle %>">
      </form>
      <% }); %>

        <form class="item" action="/" method="post">
          <input type="text" name="newItem" placeholder="New Item" autocomplete="off">

          <% if (typeof priorities !=="undefined" && priorities.length> 0) { %>
            <select name="priorityId" class="priority-select" title="Selecciona urgencia">
              <option value="">⚪ Sin urgencia</option>

              <% priorities.forEach(function(priority) { %>
                <option value="<%= priority.id %>">
                  <%= priority.icon %>
                    <%= priority.name %>
                </option>
                <% }); %>
            </select>
            <% } %>

              <button type="submit" name="list" value="<%= listTitle %>">
                +
              </button>
        </form>
  </div>

  <%- include("footer") -%>